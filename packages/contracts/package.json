{
  "name": "@openconferences/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint \"src/**/*.ts\" --config eslint.config.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "openapi:bot": "tsc -p tsconfig.json && node scripts/generate-bot-openapi.mjs",
    "openapi:bot:check": "tsc -p tsconfig.json && node scripts/generate-bot-openapi.mjs --check"
  },
  "dependencies": {
    "@openconferences/schemas": "workspace:*",
    "@ts-rest/core": "^3.52.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@openconferences/config": "workspace:*",
    "@ts-rest/open-api": "3.52.1",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
