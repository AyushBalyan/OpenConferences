generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleKind {
  PLATFORM_ADMIN
  ORG_ADMIN
  ORGANIZER
  CHAIR
  REVIEWER
  AUTHOR
}

enum MembershipScope {
  ORGANIZATION
  CONFERENCE
}

enum ConferenceStatus {
  DRAFT
  CFP_OPEN
  REVIEWING
  DECISIONS
  FINALIZATION
  COMPLETED
  ARCHIVED
}

enum BlindingMode {
  SINGLE
  DOUBLE
  OPEN
}

model Organization {
  id        String    @id @db.Uuid
  slug      String
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users        User[]
  conferences  Conference[]
  memberships  Membership[]
  tracks       Track[]

  @@map("organizations")
}

model User {
  id               String    @id @db.Uuid
  name             String
  email            String    @unique(map: "users_email_active_key")
  emailVerified    Boolean   @default(false)
  image            String?
  twoFactorEnabled Boolean?
  organizationId   String?   @db.Uuid
  version          Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  organization Organization? @relation(fields: [organizationId], references: [id])
  sessions     Session[]
  accounts     Account[]
  twoFactor    TwoFactor?
  memberships  Membership[]

  @@map("users")
}

model Session {
  id        String   @id @db.Uuid
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String    @id @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
  @@map("verifications")
}

model TwoFactor {
  id                      String    @id @db.Uuid
  secret                  String
  backupCodes             String
  userId                  String    @unique @db.Uuid
  verified                Boolean   @default(false)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factors")
}

model Conference {
  id             String           @id @db.Uuid
  organizationId String           @db.Uuid
  slug           String
  name           String
  status         ConferenceStatus @default(DRAFT)
  blindingMode   BlindingMode     @default(DOUBLE)
  cfpOpensAt     DateTime?
  cfpClosesAt    DateTime?
  biddingOpensAt DateTime?
  biddingClosesAt DateTime?
  reviewDueAt    DateTime?
  rebuttalDueAt  DateTime?
  decisionDueAt  DateTime?
  cameraReadyDueAt DateTime?
  registrationDueAt DateTime?
  reviewConfig   Json             @default("{}")
  feeSchedule    Json             @default("{}")
  version        Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  tracks       Track[]
  memberships  Membership[]

  @@index([organizationId, status])
  @@map("conferences")
}

model Track {
  id             String   @id @db.Uuid
  conferenceId   String   @db.Uuid
  organizationId String   @db.Uuid
  slug           String
  name           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  conference   Conference   @relation(fields: [conferenceId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([conferenceId])
  @@map("tracks")
}

model Membership {
  id             String          @id @db.Uuid
  userId         String          @db.Uuid
  organizationId String          @db.Uuid
  conferenceId   String?         @db.Uuid
  scope          MembershipScope
  createdAt      DateTime        @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conference   Conference?   @relation(fields: [conferenceId], references: [id], onDelete: Cascade)
  roles        RoleGrant[]

  @@unique([userId, scope, organizationId, conferenceId])
  @@index([userId])
  @@index([conferenceId])
  @@index([organizationId])
  @@map("memberships")
}

model RoleGrant {
  id           String   @id @db.Uuid
  membershipId String   @db.Uuid
  role         RoleKind
  createdAt    DateTime @default(now())

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, role])
  @@map("role_grants")
}

model AuditLog {
  id             String   @id @db.Uuid
  actorUserId    String?  @db.Uuid
  organizationId String?  @db.Uuid
  conferenceId   String?  @db.Uuid
  action         String
  entity         String
  entityId       String?
  diff           Json?
  createdAt      DateTime @default(now())

  @@index([actorUserId])
  @@index([organizationId, conferenceId])
  @@index([createdAt])
  @@map("audit_logs")
}
