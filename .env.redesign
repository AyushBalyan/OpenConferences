# Environment for the redesign branch. Local services only.
#
# This file is committed on purpose: every value is a local address or a
# placeholder, and none of them is a secret. Do not put real credentials here.
# The root .env points at production and is never read on this branch.
#
# Start everything with:  pnpm redesign:dev
# See docs/redesign/LOCAL_DEVELOPMENT.md.

NODE_ENV=development

# Database: a local Postgres started by infra/redesign/db.sh. It listens on
# loopback only and uses trust authentication, so there is no password.
# The API, the worker and migrations refuse any URL that is not local.
DATABASE_URL=postgresql://openconferences@127.0.0.1:55433/openconferences_redesign

# Redis (optional in this phase). Database 7 keeps redesign keys apart from
# the main checkout (0) and the tests (15).
REDIS_URL=redis://127.0.0.1:6379/7

# Object storage (optional in this phase): local MinIO, with its own bucket.
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=openconferences-redesign
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# API. Ports differ from the main checkout (3001 and 3000) so both can run.
API_PORT=3101
API_HOST=127.0.0.1
API_BASE_PATH=/api/v1
CORS_ORIGINS=http://localhost:3100

# apps/web-v2
WEB_URL=http://localhost:3100
NEXT_PUBLIC_API_URL=http://localhost:3101/api/v1

LOG_LEVEL=info

# Authentication. A placeholder for local sessions only, not a secret.
BETTER_AUTH_SECRET=redesign-local-development-only-not-a-secret
BETTER_AUTH_URL=http://localhost:3101

# Email: no provider key, so the worker logs emails and sends nothing.
MAIL_FROM=OpenConferences Redesign <notifications@example.com>
MAIL_CONTACT_EMAIL=contact@example.com
ZEPTO_MAIL_API_KEY=
OUTREACH_MAIL_PROVIDER=log
OUTREACH_FROM_EMAIL=outreach@example.com
OUTREACH_REPLY_TO_EMAIL=outreach@example.com

# Payments: no gateway keys, so the mock provider is used.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# File scanning is off locally.
CLAMAV_ENABLED=false
