{
  "name": "openconferences",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @openconferences/api... build && playwright test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "db:migrate": "pnpm --filter @openconferences/db migrate:dev",
    "db:migrate:deploy": "pnpm --filter @openconferences/db migrate:deploy",
    "db:seed": "pnpm --filter @openconferences/db seed",
    "db:studio": "pnpm --filter @openconferences/db studio",
    "mail:test": "pnpm --filter @openconferences/worker mail:test",
    "easydmrctest": "pnpm --filter @openconferences/worker easydmrctest",
    "prepare": "husky",
    "test:bot": "corepack pnpm --filter @openconferences/api test:bot",
    "test:e2e:bot": "playwright test --config playwright.bot.config.ts",
    "db:prepare:bot": "node infra/testing/prepare-bot-db.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@playwright/test": "^1.49.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "proxy-addr": "^2.0.8",
      "tinypool": "^2.1.2",
      "multer": "^2.5.0",
      "body-parser": "^2.4.0",
      "postcss": "^8.5.18",
      "source-map-js": "^1.2.2",
      "sharp": "^0.35.5",
      "nanoid@3": "^3.3.18",
      "deepmerge-ts": "^8.0.0",
      "vite": "^6.4.4"
    }
  }
}
