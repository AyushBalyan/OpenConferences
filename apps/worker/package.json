{
  "name": "@openconferences/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" --config eslint.config.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "mail:test": "tsx src/send-test-email.ts",
    "easydmrctest": "tsx src/easydmrctest.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.758.0",
    "@openconferences/config": "workspace:*",
    "@openconferences/db": "workspace:*",
    "@openconferences/schemas": "workspace:*",
    "pdfkit": "^0.16.0",
    "pg-boss": "^10.4.2",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@openconferences/config": "workspace:*",
    "@types/node": "^22.10.2",
    "@types/pdfkit": "^0.13.9",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
